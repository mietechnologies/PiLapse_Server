# Copy to .env and fill in before running `docker compose up -d`.
# Generate secrets with: openssl rand -hex 32
# (Stick to letters and numbers for the Mongo passwords; they go into a URL.)

# Port the server is published on.
PILAPSE_PORT=3000

# Signs user logins. Changing it logs everyone out (device tokens keep working).
JWT_SECRET=
JWT_EXPIRES_IN=30d

# MongoDB. These are only applied when the database volume is first created.
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=
MONGO_APP_USERNAME=pilapse
MONGO_APP_PASSWORD=
MONGO_DATABASE=pilapse

# Set to 1 when running behind a reverse proxy (nginx, Caddy, Cloudflare Tunnel).
TRUST_PROXY=
